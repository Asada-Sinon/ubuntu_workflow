{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "padding": { "top": 1, "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    "break",
    { "type": "title", "keyWidth": 10 },
    { "type": "separator", "string": "─────────────────────────────" },
    { "type": "os",       "key": "  OS",      "keyColor": "red" },
    { "type": "kernel",   "key": "  Kernel",  "keyColor": "red" },
    { "type": "uptime",   "key": "  Uptime",  "keyColor": "yellow" },
    { "type": "packages", "key": "  Pkgs",    "keyColor": "yellow" },
    { "type": "shell",    "key": "  Shell",   "keyColor": "green" },
    { "type": "terminal", "key": "  Term",    "keyColor": "green" },
    { "type": "de",       "key": "  DE",      "keyColor": "cyan" },
    { "type": "wm",       "key": "  WM",      "keyColor": "cyan" },
    "break",
    { "type": "cpu",      "key": "  CPU",     "keyColor": "blue" },
    { "type": "gpu",      "key": "  GPU",     "keyColor": "blue" },
    { "type": "memory",   "key": "  RAM",     "keyColor": "magenta" },
    { "type": "disk",     "key": "  Disk",    "keyColor": "magenta" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
    "break"
  ]
}
