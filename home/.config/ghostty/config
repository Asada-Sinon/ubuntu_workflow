# ═══════════════════════════════════════════════════════════════
#  Ghostty 配置
#  改完保存后按 Ctrl+Shift+, 重载，无需重启
#  全部可选项：ghostty +show-config --default --docs
# ═══════════════════════════════════════════════════════════════

# ── 字体 ────────────────────────────────────────────────────────
# 衬线(slab serif)等宽。想换风格把下面这行替换成：
#   MonaspiceXe Nerd Font Mono   —— GitHub Monaspace Xenon，slab serif
#   CodeNewRoman Nerd Font Mono  —— Times New Roman 血统，衬线感最强
#   JetBrainsMono Nerd Font Mono —— 经典无衬线，可读性最佳
font-family = IosevkaTermSlab Nerd Font Mono

# 中文/CJK 衬线 fallback —— 上面的字体没有汉字字形时用这个。
# 多行 font-family 按顺序回退，第一行是主字体。
#   LXGW WenKai Mono   —— 霞鹜文楷等宽，楷体带笔锋（当前）
#   Noto Serif CJK SC  —— 思源宋体，正统宋体衬线
font-family = LXGW WenKai Mono

font-size = 13

# 斜体用真斜体而非机器倾斜
font-style = Medium
font-style-italic = Medium Oblique

# 连字（=> -> != 会连成一个符号）；不喜欢就改成 false
font-feature = calt
font-feature = liga
font-feature = dlig

# 行高/字距微调，让衬线字体呼吸感更好
adjust-cell-height = 12%

# ── 主题 ────────────────────────────────────────────────────────
# 内置主题列表：ghostty +list-themes
# 注意名称要和列表里的写法完全一致（空格、大小写都算）
# 跟随系统亮暗：theme = light:Gruvbox Light,dark:Gruvbox Dark
theme = Gruvbox Dark

background-opacity = 0.94
background-blur = 20

# 光标
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# ── 窗口 ────────────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-theme = ghostty
window-decoration = true
window-height = 40
window-width = 130

# 标签栏（GTK）
gtk-tabs-location = top
gtk-wide-tabs = false
gtk-titlebar = true

# ── 行为 ────────────────────────────────────────────────────────
scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = true
shell-integration = zsh
shell-integration-features = cursor,sudo,title
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# 链接：Ctrl+点击 打开
link-url = true

# ── 快捷键 ──────────────────────────────────────────────────────
# 分屏
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down
keybind = ctrl+shift+w=close_surface
# 在分屏间跳转
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
# 调整分屏大小
keybind = ctrl+shift+alt+left=resize_split:left,10
keybind = ctrl+shift+alt+right=resize_split:right,10
keybind = ctrl+shift+alt+up=resize_split:up,10
keybind = ctrl+shift+alt+down=resize_split:down,10
# 标签页
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
# 字号
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
# 清屏 / 重载配置
keybind = ctrl+shift+k=clear_screen
keybind = ctrl+shift+comma=reload_config
